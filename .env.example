# ============================================================
#  Global News Platform — Environment Variables
# ============================================================
#  Copy this file to .env.local for local development:
#    cp .env.example .env.local
# ============================================================

# ── Site Configuration ─────────────────────────────────────
# Override the default site URL (used in sitemap, RSS, canonical)
# SITE_URL=https://globalnews.news

# ── RSS Ingestion ──────────────────────────────────────────
# Max articles to ingest per RSS source per run
# MAX_ARTICLES_PER_SOURCE=10

# ── Git Automation (local pipeline) ────────────────────────
# Set to "false" to skip git commit/push during local pipeline
# GIT_DISABLED=false

# ── Cloudflare Pages Deploy (local pipeline) ───────────────
# Required for automatic deployment from local machine
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CF_PROJECT=global-news-platform

# ── GitHub Actions Secrets (set in repo Settings → Secrets) ─
# CLOUDFLARE_API_TOKEN    Cloudflare API token with Pages Write permission
# CLOUDFLARE_ACCOUNT_ID   Cloudflare account ID (find in dashboard)
