# ============================================================
#  Global News Platform — Environment Variables
# ============================================================
#  Copy this file to .env.local for local development:
#    cp .env.example .env.local
# ============================================================

# ── Site Configuration ─────────────────────────────────────
# Override the default site URL (used in sitemap, RSS, canonical)
# SITE_URL=https://globalnews.news

# ── RSS Ingestion ──────────────────────────────────────────
# Max articles to ingest per RSS source per run
# MAX_ARTICLES_PER_SOURCE=10

# Concurrency for parallel RSS fetching (default: 5)
# FETCH_CONCURRENCY=5

# Cache TTL in minutes for RSS responses (default: 15)
# CACHE_TTL_MINUTES=15

# ── AI Processing ──────────────────────────────────────────
# AI provider: "groq" (default, free), "ollama" (local), or "openai"
# AI_PROVIDER=groq

# Groq (free tier — get API key at https://console.groq.com)
# Models: llama-3.3-70b-versatile (default), llama3-8b-8192, mixtral-8x7b-32768
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local AI — no API key needed)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Disable automatic fallback between providers (groq → ollama)
# AI_FALLBACK_DISABLED=false

# Default editorial tone: neutral, analytical, modern, global, tech
# EDITORIAL_TONE=neutral

# Default article length: short (~150w), medium (~400w), long (~800w)
# EDITORIAL_LENGTH=medium

# Skip AI rewriting and use local extractive summarization
# EDITORIAL_DISABLED=false

# Quality threshold (0-100). Articles below this are rejected (default: 20)
# QUALITY_THRESHOLD=20

# ── Publishing ─────────────────────────────────────────────
# Minimum gap between article publications in minutes (default: 5)
# PUBLISH_INTERVAL_MINUTES=5

# ── Git Automation (local pipeline) ────────────────────────
# Set to "true" to skip git commit/push during local pipeline
# GIT_DISABLED=false

# ── Vercel Deployment ──────────────────────────────────────
# Required for automatic deployment from CI/CD
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ── GitHub Actions Secrets (set in repo Settings → Secrets) ─
# VERCEL_TOKEN            Vercel API token
# VERCEL_ORG_ID           Vercel team ID
# VERCEL_PROJECT_ID       Vercel project ID
