{
  "name": "global-news-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "rimraf .next",
    "prebuild": "npm run clean",
    "build": "next build",
    "start": "node serve-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ingest": "node scripts/run-fetch.js",
    "ingest:single": "node scripts/run-fetch.js --source",
    "ingest:dry": "node scripts/run-fetch.js --dry-run",
    "pipeline": "node scripts/full-pipeline.js",
    "pipeline:dry": "node scripts/full-pipeline.js --dry-run --no-build",
    "pipeline:no-build": "node scripts/full-pipeline.js --no-build",
    "pipeline:no-git": "node scripts/full-pipeline.js --no-git",
    "verify": "node scripts/full-pipeline.js --no-git --no-build",
    "sitemap": "node scripts/lib/sitemap.js",
    "feed": "node scripts/lib/feed.js",
    "trending": "node -e \"const { computeTrending, computeDailyMetrics } = require('./scripts/lib/metrics'); const t = computeTrending(20); computeDailyMetrics(); console.log(JSON.stringify(t, null, 2));\"",
    "admin:status": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('scripts','data');const f=f=>{try{return JSON.parse(fs.readFileSync(p.join(d,f),'utf-8'))}catch{}};console.log('Articles:',fs.readdirSync(p.join('src','data','articles')).filter(x=>x.endsWith('.mdx')).length);console.log('Queue:',f('schedule.json')?.queue?.length||0);console.log('Published:',f('schedule.json')?.history?.length||0);console.log('Processed URLs:',Object.keys(f('processed.json')||{}).length);console.log('Trending items:',f('trending.json')?.trending?.length||0);\"",
    "health": "node -e \"const h=require('./scripts/lib/health');console.log(JSON.stringify(h.getAllStatuses(),null,2));\"",
    "cache:clear": "node -e \"const c=require('./scripts/lib/cache');c.clear();console.log('Cache cleared');\"",
    "cache:stats": "node -e \"const c=require('./scripts/lib/cache');console.log(JSON.stringify(c.stats()));\"",
    "editorial:test": "node scripts/editorial/test.js",
    "editorial:single": "node scripts/editorial/run.js",
    "editorial:batch": "node scripts/editorial/batch.js"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/mdx": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.1.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.1.3",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4"
  }
}
